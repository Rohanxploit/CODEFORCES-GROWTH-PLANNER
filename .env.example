# Copy to server/.env and fill in. Never commit real values.

# ---------- server ----------
NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/codeforces-growth-planner (run `npm run dev:db`)
# Atlas: mongodb+srv://<user>:<password>@<cluster>/codeforces-growth-planner
MONGODB_URI=mongodb://127.0.0.1:27017/codeforces-growth-planner
# Long random string (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# lax when the frontend proxies /api (recommended); none only for direct cross-site calls
COOKIE_SAME_SITE=lax
# Login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Proxy hops in front of the API (1 = Render only, 2 = Vercel rewrite + Render)
TRUST_PROXY=1
CODEFORCES_API_BASE=https://codeforces.com/api

# ---------- client (client/.env) ----------
# Leave empty: Vite proxies /api in development and Vercel rewrites it in production.
VITE_API_BASE_URL=
